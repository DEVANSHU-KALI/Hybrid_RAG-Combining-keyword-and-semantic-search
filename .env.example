OPENROUTER_API_KEY=your_api_key

LANGCHAIN_API_KEY=your_api_key

LANGCHAIN_TRACING_V2=true

LANGCHAIN_PROJECT=Hybrid-RAG

LLM_PROVIDER=local
LOCAL_LLM_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=your_local_model

# You can leave your GROQ_API_KEY here safely; it will be ignored when LLM_PROVIDER=local
# if want to use the groq model, you can set LLM_PROVIDER=groq and provide your GROQ_API_KEY below
GROQ_API_KEY=your_api_key